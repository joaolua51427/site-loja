# Copie para .env.local e preencha. NUNCA faça commit de .env / .env.local.
# Variáveis com prefixo NEXT_PUBLIC_ vão para o navegador: só chaves PÚBLICAS.

# Supabase (banco, login, storage) — Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (etapas 3+): chave secreta para estoque, pedidos e pagamentos
SUPABASE_SECRET_KEY=

# Pagamento — Mercado Pago (etapa 4). Só no servidor.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Frete — Melhor Envio. Só no servidor. Sem token, a loja usa a tabela de frete por UF do banco.
MELHOR_ENVIO_TOKEN=
# https://sandbox.melhorenvio.com.br (teste) ou https://melhorenvio.com.br (produção)
MELHOR_ENVIO_URL=
# E-mail de contato técnico exigido pelo Melhor Envio no cabeçalho User-Agent
MELHOR_ENVIO_CONTATO=

# E-mails — Resend (etapa 7). Só no servidor.
RESEND_API_KEY=

# Domínio público da loja (CORS, URLs de retorno)
NEXT_PUBLIC_SITE_URL=
