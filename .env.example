# Copie para .env.local e preencha. NUNCA faça commit de .env / .env.local.
# Variáveis com prefixo NEXT_PUBLIC_ vão para o navegador: só chaves PÚBLICAS.

# Banco / autenticação (ex.: Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor:
SUPABASE_SERVICE_ROLE_KEY=

# Pagamento (só no servidor)
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Domínio público da loja (usado para CORS e URLs de retorno)
NEXT_PUBLIC_SITE_URL=
